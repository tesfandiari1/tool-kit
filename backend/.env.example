# Local development binds to loopback by default. Docker Compose overrides this
# inside the container while keeping the published host port on loopback.
TOOLKIT_CONVERTER_BIND_ADDR=127.0.0.1:8080
TOOLKIT_CONVERTER_TOKEN_FILE=/absolute/path/to/bootstrap-token
TOOLKIT_CONVERTER_SCRATCH_PARENT=/tmp
TOOLKIT_CONVERTER_MAX_UPLOAD_BYTES=26214400
TOOLKIT_CONVERTER_MAX_OUTPUT_BYTES=52428800
TOOLKIT_CONVERTER_MAX_JOBS=32
TOOLKIT_CONVERTER_MAX_CONCURRENT_UPLOADS=2
TOOLKIT_CONVERTER_UPLOAD_TIMEOUT_SECS=120
TOOLKIT_CONVERTER_PDF_TIMEOUT_SECS=60
TOOLKIT_CONVERTER_PDF_THREADS=2
RUST_LOG=tool_kit_converter=info
