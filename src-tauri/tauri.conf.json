{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tool-Kit",
  "version": "1.0.0",
  "identifier": "dev.esfandiari.toolkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tool-Kit",
        "width": 560,
        "height": 560,
        "minWidth": 480,
        "minHeight": 460,
        "resizable": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "copyright": "Copyright (c) 2026 Tristin Esfandiari",
    "category": "Productivity",
    "resources": {
      "../src/ui/fonts/OFL.txt": "OFL.txt",
      "../src/ui/fonts/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "26.0"
    }
  }
}
