{
  "name": "tool-kit",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "build": "pnpm --dir apps/desktop build",
    "preview": "pnpm --dir apps/desktop preview",
    "lint": "pnpm --dir apps/desktop lint",
    "lint:fix": "pnpm --dir apps/desktop lint:fix",
    "typecheck": "pnpm --dir apps/desktop typecheck",
    "test": "pnpm --dir apps/desktop test",
    "test:watch": "pnpm --dir apps/desktop test:watch",
    "check": "pnpm --dir apps/desktop check",
    "sidecars": "apps/desktop/src-tauri/scripts/build-sidecars.sh",
    "backend:docker": "apps/desktop/src-tauri/scripts/backend-override.sh",
    "backend:sidecar": "apps/desktop/src-tauri/scripts/backend-override.sh --clear",
    "backend:where": "apps/desktop/src-tauri/scripts/backend-override.sh --show",
    "tauri": "pnpm sidecars && pnpm --dir apps/desktop tauri",
    "lint:api": "spectral lint contract/http/openapi.yaml --ruleset contract/http/.spectral.yaml --fail-severity=warn",
    "verify": "pnpm sidecars && pnpm check && pnpm build && cargo clippy --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --lib",
    "verify:backend": "pnpm lint:api && cargo clippy --locked --manifest-path apps/converter/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path apps/converter/Cargo.toml",
    "verify:all": "pnpm verify && pnpm verify:backend",
    "verify:deps": "cargo deny --manifest-path apps/desktop/src-tauri/Cargo.toml check && cargo deny --manifest-path apps/converter/Cargo.toml check && cargo deny --manifest-path crates/worker-protocol/Cargo.toml check",
    "verify:contract": "apps/converter/scripts/contract-fuzz.sh",
    "verify:container": "apps/converter/scripts/container-smoke.sh",
    "verify:local-corpus": "apps/converter/scripts/verify-local-corpus.sh",
    "verify:api-drift": "apps/converter/scripts/verify-api-drift.sh",
    "verify:release": "apps/desktop/src-tauri/scripts/verify-release.sh",
    "trace:failures": "apps/desktop/src-tauri/scripts/trace-failures.sh",
    "generate:api": "openapi-typescript contract/http/openapi.yaml -o apps/desktop/src/app/api/schema.ts"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.16.3",
    "openapi-typescript": "^7.13.0"
  }
}
