{
  "name": "tool-kit",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:api": "spectral lint backend/openapi/openapi.yaml --ruleset backend/openapi/.spectral.yaml --fail-severity=warn",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && eslint . && vitest run",
    "verify": "pnpm check && pnpm build && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path src-tauri/Cargo.toml --lib",
    "verify:backend": "pnpm lint:api && cargo clippy --locked --manifest-path backend/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path backend/Cargo.toml",
    "verify:all": "pnpm verify && pnpm verify:backend",
    "verify:deps": "cargo deny --manifest-path src-tauri/Cargo.toml check && cargo deny --manifest-path backend/Cargo.toml check && cargo deny --manifest-path crates/worker-protocol/Cargo.toml check",
    "verify:contract": "backend/scripts/contract-fuzz.sh",
    "verify:container": "backend/scripts/container-smoke.sh",
    "verify:local-corpus": "backend/scripts/verify-local-corpus.sh",
    "verify:api-drift": "backend/scripts/verify-api-drift.sh",
    "verify:release": "src-tauri/scripts/verify-release.sh",
    "generate:api": "openapi-typescript backend/openapi/openapi.yaml -o src/app/api/schema.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.16.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.18"
  }
}
