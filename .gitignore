# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and frontend build
node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# tsconfig.node.json is a composite project, so it cannot set noEmit (TS6310).
# Its output is redirected to node_modules/.tmp. These two are what leaked into
# the frontend root before that fix, and are never source.
/apps/desktop/vite.config.js
/apps/desktop/vite.config.d.ts

# Secrets and local env
.env
.env.*

# Per-developer agent, editor and tool state. CLAUDE.md and AGENTS.md are the
# shared agent instructions. `gitnexus analyze` regenerates .claude/skills/.
.claude/
.cursor/
.firecrawl/
.impeccable/
.gitnexus/

# Runtime / local data (SQLite, job artifacts)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Rust (crate gitignores already cover /target/ in each crate)
/target/

# Sidecar staging. build-sidecars.sh writes all three, and every file in them
# is derived: four Mach-O binaries from cargo, swiftc and SwiftPM, the bcmaps
# and licences from the pdf-inspector crate source, and the diarizer models
# fetched from Hugging Face. Roughly 55 MB that a clean checkout rebuilds in
# one command.
/apps/desktop/src-tauri/binaries/
/apps/desktop/src-tauri/resources/pdf-inspector/
/apps/desktop/src-tauri/resources/fluidaudio/

# Python bytecode (the icon generator is the only .py in the tree)
__pycache__/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Apple signing material (creds themselves live in .env.local). *.p8 is an
# App Store Connect API key.
*.p12
*.pfx
*.cer
*.p8
*.pem
*.mobileprovision

# Swift and Xcode. Opening a SwiftPM worker in Xcode writes per-user state.
.build/
.swiftpm/
xcuserdata/
DerivedData/

# Model weights are gigabytes, and an accidental `git add` of one is hard to
# undo in a public history.
*.safetensors
*.gguf
*.metallib

# Release hand-off: the DMG, checksum, notes and images for the GitHub release
# page. A DMG belongs on a release, never in git.
/release/
*.dmg
