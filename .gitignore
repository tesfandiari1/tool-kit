# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and frontend build
node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# tsconfig.node.json is a composite project, so it cannot set noEmit (TS6310).
# Its output is redirected to node_modules/.tmp. These two are what leaked into
# the frontend root before that fix, and are never source.
/apps/desktop/vite.config.js
/apps/desktop/vite.config.d.ts

# Secrets and local env. Keep committed examples.
.env
.env.*
!.env.example
deploy/docker/secrets/

# Local tool caches and agent state
.firecrawl/
.impeccable/
.cursor/hooks/state/
.gitnexus/

# Runtime / local data (SQLite, job artifacts)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
apps/converter/data/

# Rust (crate gitignores already cover /target/ in each crate)
/target/

# Sidecar staging. build-sidecars.sh writes all three, and every file in them
# is derived: four Mach-O binaries from cargo, swiftc and SwiftPM, the bcmaps
# and licences from the pdf-inspector crate source, and the diarizer models
# fetched from Hugging Face. Roughly 55 MB that a clean checkout rebuilds in
# one command.
/apps/desktop/src-tauri/binaries/
/apps/desktop/src-tauri/resources/pdf-inspector/
/apps/desktop/src-tauri/resources/fluidaudio/

# Python bytecode (the icon generator is the only .py in the tree)
__pycache__/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Apple signing leftovers (creds themselves live in .env.local)
*.p12
*.pfx
*.cer
*.mobileprovision

# Schemathesis writes an example database beside the working directory when
# it is not told otherwise. contract-fuzz.sh keeps it in memory; this covers a
# hand-run `st`.
.schemathesis/

# Hypothesis writes its own nested .gitignore holding a bare `*`, so the
# directory hides itself. That is the tool's choice, not ours, and it vanishes
# if the tool changes its mind. Name it here so the root list is the answer.
.hypothesis/

# Local model weights and the MLX build surface. Weights are derived: they are
# fetched from a pinned revision in the model registry and verified by hash, so
# deleting them costs a download and never content. They are also gigabytes,
# and an accidental `git add` of one is not something you undo cleanly. These
# land before the first fetch rather than after it.
models/cache/
*.safetensors
*.gguf
*.metallib
.build/
